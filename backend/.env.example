# Copy to backend/.env and fill in your own values.
# backend/.env is git-ignored; this example file is safe to commit.

# Google Gemini API key for the AI Healthcare Assistant.
# Create one at https://aistudio.google.com/apikey (never commit the real key).
GEMINI_API_KEY=

# Optional overrides (defaults live in config/config.py).
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_ATTEMPTS=2
# GEMINI_MAX_OUTPUT_TOKENS=2048

# Flask backend development configuration.
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
